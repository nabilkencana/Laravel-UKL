            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rian Pratama\",\n  \"phone_number\": \"089876543210\",\n  \"password\": \"{{test_password}}\",\n  \"password_confirmation\": \"{{test_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Pendaftaran akun jika user hanya memiliki nomor WhatsApp (aturan: required_without:email)."
          }
        },
        {
          "name": "Login - Menggunakan Email",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.token) {",
                  "    pm.environment.set(\"token\", jsonData.data.token);",
                  "    console.log(\"Token login tersimpan di environment:\", jsonData.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identity\": \"{{test_email}}\",\n  \"password\": \"{{test_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login-email",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login-email"
              ]
            },
            "description": "Login menggunakan kredensial Email dan kata sandi. Menghasilkan token Sanctum yang otomatis disimpan ke variabel 'token'."
          }
        },
        {
          "name": "Login - Menggunakan Username",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.token) {",
                  "    pm.environment.set(\"token\", jsonData.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identity\": \"budi_santoso\",\n  \"password\": \"{{test_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login-email",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login-email"
              ]
            },
            "description": "Login menggunakan username (controller mendeteksi apakah identity berupa email atau username)."
          }
        },
        {
          "name": "Get User Profile (Protected)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Data user terdefinisi\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.id).to.not.be.undefined;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/user",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "user"
              ]
            },
            "description": "Mengambil informasi profil user yang sedang aktif. Memerlukan Authorization: Bearer {{token}}."
          }
        }
      ]
    },
    {
      "name": "2. Login via OTP WhatsApp",
      "description": "Folder alur autentikasi tanpa kata sandi (*passwordless login*) melalui kode OTP nomor WhatsApp.",
      "item": [
        {
          "name": "1. Request OTP WhatsApp",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Response success is true\", function () {",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone_number\": \"{{test_phone}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/request-otp-wa",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "request-otp-wa"
              ]
            },
            "description": "Mengirimkan permintaan pembuatan kode OTP WhatsApp 6-digit. Berlaku selama 5 menit."
          }
        },
        {
          "name": "2. Verify OTP WhatsApp",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.token) {",
                  "    pm.environment.set(\"token\", jsonData.data.token);",
                  "    console.log(\"Token dari verifikasi OTP WhatsApp disimpan:\", jsonData.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone_number\": \"{{test_phone}}\",\n  \"otp_code\": \"{{otp_code}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/verify-otp-wa",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "verify-otp-wa"
              ]
            },
            "description": "Memvalidasi kode OTP yang dikirim ke WhatsApp. Jika benar, mengembalikan token autentikasi Sanctum dan menghapus OTP dari database."
          }
        }
      ]
    },
    {
      "name": "3. Pemulihan Kata Sandi (Forgot Password)",
