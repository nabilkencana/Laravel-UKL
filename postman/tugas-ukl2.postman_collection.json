            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Testing User\",\n  \"email\": \"test_mismatch@example.com\",\n  \"password\": \"Password123!\",\n  \"password_confirmation\": \"PasswordBeda999!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "register"
              ]
