                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"{{test_phone}}\",\n  \"otp_code\": \"{{otp_code}}\",\n  \"password\": \"PasswordBaru456!\",\n  \"password_confirmation\": \"PasswordBaru456!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/forgot-password/reset",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "forgot-password",
                "reset"
              ]
            },
            "description": "Memvalidasi OTP forgot_password dan mengubah kata sandi pengguna dengan password baru."
          }
        }
      ]
    },
    {
