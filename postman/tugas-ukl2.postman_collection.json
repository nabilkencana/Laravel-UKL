      "item": [
        {
          "name": "1. Request Reset Password via WhatsApp",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.expect(jsonData.success).to.be.true;"
