                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Pesan password mismatch muncul\", function () {",
                  "    pm.expect(jsonData.errors.password[0]).to.include(\"Konfirmasi kata sandi tidak cocok\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
