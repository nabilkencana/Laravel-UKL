{
  "info": {
    "_postman_id": "c1f7b889-4d32-4e92-97b5-779919f2a4de",
    "name": "Tugas UKL 2 - Authentication & User API",
    "description": "Koleksi lengkap Postman untuk pengujian API Autentikasi dan Manajemen Pengguna Tugas UKL 2.\nMendukung registrasi, login multi-identitas, verifikasi OTP WhatsApp, reset kata sandi, dan autentikasi token Sanctum.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Autentikasi (Register & Login)",
      "description": "Folder berisi endpoint pendaftaran akun baru, login via email/username, dan pengambilan profil pengguna terotentikasi.",
      "item": [
        {
          "name": "Register - Email & WhatsApp",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.token) {",
                  "    pm.environment.set(\"token\", jsonData.data.token);",
                  "    console.log(\"Sanctum token disimpan otomatis ke environment:\", jsonData.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Budi Santoso\",\n  \"email\": \"{{test_email}}\",\n  \"phone_number\": \"{{test_phone}}\",\n  \"password\": \"{{test_password}}\",\n  \"password_confirmation\": \"{{test_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Pendaftaran akun baru dengan menyertakan nama, email, nomor WhatsApp, serta konfirmasi kata sandi. Mengembalikan token Bearer Sanctum."
          }
        },
        {
          "name": "Register - Hanya Email",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.token) {",
                  "    pm.environment.set(\"token\", jsonData.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Siti Rahma\",\n  \"email\": \"siti.rahma@example.com\",\n  \"password\": \"{{test_password}}\",\n  \"password_confirmation\": \"{{test_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Pendaftaran akun jika user hanya memiliki alamat email (aturan: required_without:phone_number)."
          }
        },
        {
          "name": "Register - Hanya Nomor WhatsApp",
          "event": [
